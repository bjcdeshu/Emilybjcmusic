# REVIEW TEMPLATE ONLY — insert into Emily's dedicated HTTPS server block.
# Not a complete server: certificate, server_name, port and topology require approval.
# Candidate upstream 127.0.0.1:3100 was unoccupied on RN at 2026-09-30 review.
# Do not apply to the personal main site or alter shared OpenResty configuration.
location /api/ {
    proxy_pass http://127.0.0.1:3100;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Connection "";
    # Backend intentionally does not trust forwarded client addresses.
    proxy_set_header X-Forwarded-For "";
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header X-Forwarded-Proto "";
    proxy_set_header Forwarded "";
    proxy_set_header Range $http_range;
    proxy_set_header If-Range $http_if_range;
    proxy_cache off;
    proxy_store off;
    proxy_buffering off;
    proxy_intercept_errors off;
    proxy_read_timeout 150s;
    # No URL, QR ticket, cookie or request-body access logging.
    access_log off;
    error_log /dev/null crit;
}

location / {
    proxy_pass http://127.0.0.1:3100;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Connection "";
    proxy_cache off;
    proxy_store off;
    proxy_intercept_errors off;
    access_log off;
    error_log /dev/null crit;
}
