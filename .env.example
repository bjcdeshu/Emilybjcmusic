# Local combined frontend/backend example. Values marked private must be provisioned locally.
# This file contains NO real credentials. Node entrypoints read process.env, not dotenv automatically.
# Run from the repository root: node --env-file=.env apps/server/dist/index.js

EMILY_HOST=127.0.0.1
EMILY_PORT=3000
EMILY_PUBLIC_ORIGIN=http://127.0.0.1:3000
EMILY_WEB_DIST_DIR=./apps/web/dist
EMILY_DATA_DIR=./state/emily

# Private owner password: 12-1024 characters. Empty means protected access remains closed.
EMILY_OWNER_PASSWORD=
EMILY_SESSION_TTL_SECONDS=43200
# Private AES-GCM credential key: 64 hex characters. Required for storing an authorized QR login.
EMILY_CREDENTIAL_KEY=

# Operator-controlled private NetEase-compatible API. Disable ENABLE_GENERAL_UNBLOCK in that adapter.
EMILY_NETEASE_API_BASE=
EMILY_NETEASE_API_TOKEN=
# Prefer owner's QR confirmation; optional owner's cookie must never be printed or committed.
EMILY_NETEASE_COOKIE=

# OpenAI-compatible application channel. Include /v1 in the base where required.
EMILY_MODEL_BASE_URL=
EMILY_MODEL_API_KEY=
EMILY_MODEL_NAME=
EMILY_HTTP_TIMEOUT_MS=12000

EMILY_TTS_ENABLED=true
EMILY_TTS_COMMAND=uvx
EMILY_TTS_VOICE=zh-CN-XiaoxiaoNeural
EMILY_TTS_TIMEOUT_MS=25000

# Optional official Gemini 3.8 Flash-Lite TTS; explicit Gemini voice uses this provider.
# Dedicated secret from Google AI Studio. Never use the writing-model key here.
EMILY_GEMINI_TTS_API_KEY=
# Operator attestation only, not a Google billing switch or API proof.
# Keep false until the key's project/model Free Tier eligibility is confirmed.
# Reconfirm after key/project/tier changes. Never enable paid billing as a fallback.
EMILY_GEMINI_TTS_FREE_TIER_CONFIRMED=false
# Enables saving gemini:Sulafat as the host. Does NOT migrate an existing saved voice.
# Final hosting scripts are sent to Google; Free Tier data-use terms apply.
EMILY_GEMINI_TTS_HOSTING_ENABLED=false
